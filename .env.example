# URL dan kunci publik Supabase (aman untuk browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Kunci rahasia service role (HANYA di server, JANGAN pernah dimasukkan ke NEXT_PUBLIC_*)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Mode autentikasi dan data tiruan untuk pengembangan lokal (default: false)
# PERINGATAN: Dilarang menyalakan AUTH_TIRUAN di lingkungan produksi (NODE_ENV=production)
AUTH_TIRUAN=false
